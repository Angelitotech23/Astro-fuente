# Variables públicas de Astro-fuente.
#
# El proyecto no tiene paso de compilación, así que el navegador no lee este archivo.
# Estos dos valores se escriben en src/js/config.js. Son públicos por diseño:
# la clave publicable solo permite lectura (RLS).
#
# NUNCA incluyas aquí ni en el repositorio la clave service_role ni ningún secreto.
#
# SUPABASE_URL=https://<proyecto>.supabase.co   # URL del proyecto (pendiente: proyecto no creado)
# SUPABASE_PUBLISHABLE_KEY=<clave-publicable>   # Clave publicable de solo lectura (pendiente)
